# Copy to .env and adjust. Command line options (--today, --provider, --tasks, --out)
# take precedence over these values.

# Evaluation date for deadline arithmetic (UTC, YYYY-MM-DD). Empty = today.
EVALUATION_DATE=2026-10-21

# LLM provider: "stub" is deterministic and offline, "anthropic" calls the Messages API.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=30
# Retries done by the SDK for 429/5xx/connection errors, per request.
LLM_MAX_RETRIES=2
# Ceiling on model calls in one run. Beyond it, tasks routed by their note wait for the
# next run and messages use their templates.
LLM_MAX_CALLS_PER_RUN=500
# USD per million tokens, used only for the cost estimate in the run summary.
LLM_PRICE_INPUT_PER_MTOK=4.00
LLM_PRICE_OUTPUT_PER_MTOK=20.00

# Rules
ESCALATE_AFTER_DAYS=5
STALE_AFTER_DAYS=5
DUE_SOON_DAYS=2

# Reminders: with more than 0 days, a task whose data stays unchanged is followed up again that
# many days after the previous message was delivered, MAX_REMINDERS times at most. One interval
# after the last reminder it is escalated once (to ESCALATION_TARGET). 0 = off: one follow-up
# per task state.
REMIND_EVERY_DAYS=0
MAX_REMINDERS=2

# Delivery: park a follow-up as a dead letter after it failed in this many runs, or at once when
# the provider rejects it for good (HTTP 4xx except 408 and 429). A dead letter is not sent
# again and makes the run exit 2. 0 = off: a failed follow-up is retried on every run.
MAX_FAILED_RUNS=0

# Approval: with true (or 1), an escalation is drafted and stored as awaiting_approval, and it is
# sent only after `followup approve ACTION_ID`. Read the wording with `followup list
# awaiting_approval`. Waiting escalations do not change the exit code; the run summary lists them.
APPROVE_ESCALATIONS=false

# Recipients of role-addressed messages (delivery is mocked; these are mailbox names).
CLARIFY_TARGET=project_manager
ESCALATION_TARGET=project_manager
MATERIALS_TARGET=warehouse

# Input served by the mock tasks API, and the directory for state and artefacts.
TASKS_FILE=fixtures/tasks.json
OUT_DIR=out
